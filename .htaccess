RewriteEngine On

# 1. Route /press AND its sub-paths (like /press/view-magazine)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^press(/.*)?$ press.html [QSA,L]

# 2. Make CV clean too (optional, but highly recommended)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^cv(/.*)?$ cv.html [QSA,L]

# 3. Route all gallery paths (like /painting/1980s) to index
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [QSA,L]