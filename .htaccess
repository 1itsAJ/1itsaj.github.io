RewriteEngine On

# 1. Route /press and its sub-paths to press.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^press(/.*)?$ press.html [QSA,L]

# 2. Route /cv to cv.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^cv$ cv.html [QSA,L]

# 3. Route everything else (gallery paths) to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.html [QSA,L]